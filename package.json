{
  "name": "nih-reporter-mcp",
  "version": "0.1.0",
  "description": "MCP connector for the NIH RePORTER API (grants, investigators, funding, linked publications)",
  "type": "module",
  "private": true,
  "bin": { "nih-reporter-mcp": "dist/stdio.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
